# Copy to .env (chmod 600). README.md, "Run it", says where each one comes from.
TS_AUTHKEY=
TS_HOSTNAME=backstage
# https://<TS_HOSTNAME>.<your tailnet>.ts.net, no trailing slash
BACKSTAGE_URL=
# openssl rand -hex 24, for each
POSTGRES_PASSWORD=
AUTH_SESSION_SECRET=
# The workbench AUGUR's Keycloak: <its PLATFORM_URL>/sso/realms/platform/.well-known/openid-configuration
OIDC_METADATA_URL=
OIDC_CLIENT_ID=backstage
# Printed by deploy/keycloak-client.sh
OIDC_CLIENT_SECRET=
# Read-only GitHub token with Contents read on im-platform (the Updates page's release-feed token will do)
GITHUB_TOKEN=
# AUGUR's pipeline feed, for the channels and deployment cards: a GitHub user and a classic token with
# read:packages (the same kind of read key an AUGUR server pulls its images and feeds with)
GITHUB_READ_USER=
GITHUB_READ_KEY=
BACKSTAGE_VERSION=latest
